<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Patient - ClinicCare</title>
</head>

<body>

    <h1>Edit Patient</h1>

    <p>Patient ID: <%= id %></p>

    <form action="/patients/edit/<%= id %>" method="POST">

        <label>Patient Name:</label>
        <input type="text" name="name" required>

        <br><br>

        <label>Email:</label>
        <input type="email" name="email" required>

        <br><br>

        <label>Phone:</label>
        <input type="text" name="phone" required>

        <br><br>

        <button type="submit">Update Patient</button>

    </form>

    <br>

    <a href="/patients">Back to Patients</a>

</body>
</html>