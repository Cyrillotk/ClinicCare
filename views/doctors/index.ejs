<%- include('../partials/header', { title: 'Doctors' }) %>
<%- include('../partials/nav') %>
<%- include('../partials/messages') %>

<h1>Doctors</h1>

<a href="/doctors/new">Add New Doctor</a>

<div class="search-bar">
    <form action="/doctors" method="GET">
        <input type="text" name="search" placeholder="Search by name or specialization" value="<%= search %>">
        <button type="submit">Search</button>
    </form>
</div>

<% if (doctors.length === 0) { %>

    <p>No doctors registered yet.</p>

<% } else { %>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Specialization</th>
                <th>Phone</th>
                <th>Available Days</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% doctors.forEach(function(doctor) { %>
                <tr>
                    <td><%= doctor.name %></td>
                    <td><%= doctor.specialization %></td>
                    <td><%= doctor.phone %></td>
                    <td><%= doctor.availableDays.join(', ') %></td>

                    <td class="actions">
                        <a href="/doctors/<%= doctor._id %>/edit">Edit</a>

                        <form action="/doctors/<%= doctor._id %>/delete" method="POST"
                              onsubmit="return confirm('Delete this doctor?');">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

<% } %>

<%- include('../partials/footer') %>